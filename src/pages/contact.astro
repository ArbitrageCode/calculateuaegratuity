---
import Layout from '../layouts/Layout.astro';

const title = 'Contact UAE Gratuity Calculator — Get in Touch';
const description =
  'Contact the UAE Gratuity Calculator team. Report an error, suggest a feature, or ask a question about end-of-service gratuity calculations under UAE labour law.';
---

<Layout title={title} description={description}>
  <section class="bg-canvas py-12 sm:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-[11px] font-mono text-mute uppercase tracking-widest mb-4">CONTACT</p>
      <h1 class="text-[32px] sm:text-[40px] font-semibold leading-[1.1] tracking-[-1.5px] text-ink mb-6">
        Get in touch.
      </h1>
      <p class="text-[18px] text-body leading-[1.6] mb-12 max-w-2xl">
        Have a question, spotted an error in a calculation, or want to suggest an improvement? We read every message.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-14">
        <div class="bg-canvas-soft rounded-[8px] p-5 border border-hairline">
          <div class="w-8 h-8 rounded-[6px] bg-canvas border border-hairline flex items-center justify-center mb-3" aria-hidden="true">
            <svg class="w-4 h-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink mb-1">Report an error</p>
          <p class="text-[13px] text-body leading-relaxed">Found a calculation that doesn't match the Article 51 formula? Let us know the details and we'll investigate.</p>
        </div>
        <div class="bg-canvas-soft rounded-[8px] p-5 border border-hairline">
          <div class="w-8 h-8 rounded-[6px] bg-canvas border border-hairline flex items-center justify-center mb-3" aria-hidden="true">
            <svg class="w-4 h-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink mb-1">Suggest a feature</p>
          <p class="text-[13px] text-body leading-relaxed">Want to see a scenario, contract type, or calculation not currently supported? We're open to suggestions.</p>
        </div>
        <div class="bg-canvas-soft rounded-[8px] p-5 border border-hairline">
          <div class="w-8 h-8 rounded-[6px] bg-canvas border border-hairline flex items-center justify-center mb-3" aria-hidden="true">
            <svg class="w-4 h-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink mb-1">Ask a question</p>
          <p class="text-[13px] text-body leading-relaxed">Have a general question about UAE gratuity rules? We'll do our best to point you in the right direction.</p>
        </div>
      </div>

      <!-- Contact form -->
      <div
        class="bg-canvas rounded-xl border border-hairline p-6 sm:p-8"
        style="box-shadow: 0px 2px 2px #0000000a, 0px 8px 16px -4px #0000000a;"
      >
        <h2 class="text-[18px] font-semibold text-ink mb-6">Send us a message</h2>
        <form id="contact-form" novalidate class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-ink mb-1.5">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Your name"
                class="w-full h-10 px-3 bg-canvas border border-hairline rounded-[6px] text-sm text-ink placeholder-mute focus:outline-none focus:border-hairline-strong transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="w-full h-10 px-3 bg-canvas border border-hairline rounded-[6px] text-sm text-ink placeholder-mute focus:outline-none focus:border-hairline-strong transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-ink mb-1.5">Subject</label>
            <select
              id="subject"
              name="subject"
              class="w-full h-10 px-3 bg-canvas border border-hairline rounded-[6px] text-sm text-ink focus:outline-none focus:border-hairline-strong transition-colors appearance-none"
            >
              <option value="error">Report a calculation error</option>
              <option value="feature">Suggest a feature</option>
              <option value="question">General question</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-ink mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Describe your question, issue, or suggestion..."
              class="w-full px-3 py-2.5 bg-canvas border border-hairline rounded-[6px] text-sm text-ink placeholder-mute focus:outline-none focus:border-hairline-strong transition-colors resize-none"
            ></textarea>
          </div>

          <div id="form-error" class="hidden px-4 py-3 rounded-[6px] bg-error-soft text-error-deep text-sm" role="alert"></div>
          <div id="form-success" class="hidden px-4 py-3 rounded-[6px] bg-canvas-soft border border-hairline text-body text-sm" role="status"></div>

          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center justify-center h-11 px-7 bg-ink text-on-primary text-sm font-medium rounded-full hover:opacity-90 transition-opacity focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            Send message
          </button>
        </form>
      </div>

      <div class="mt-10 p-5 rounded-[8px] bg-canvas-soft border border-hairline">
        <p class="text-sm font-medium text-ink mb-1">Prefer email?</p>
        <p class="text-sm text-body">
          You can also reach us directly at{' '}
          <a href="mailto:hello@calculateuaegratuity.com" class="text-link hover:underline font-mono text-[13px]">hello@calculateuaegratuity.com</a>
        </p>
      </div>

      <div class="mt-10 pt-8 border-t border-hairline">
        <p class="text-sm text-mute mb-1 font-medium">For urgent gratuity disputes</p>
        <p class="text-sm text-body">
          Contact MOHRE directly at <strong class="text-ink">800-60</strong> or through the MOHRE app. Mediation is free and resolves most straightforward underpayment disputes without going to court.
        </p>
      </div>

      <div class="mt-10 pt-8 border-t border-hairline">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-medium text-ink hover:opacity-70 transition-opacity"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
          </svg>
          Back to calculator
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error')!;
  const successEl = document.getElementById('form-success')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

    if (!name) { showError('Please enter your name.'); return; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('Please enter a valid email address.'); return; }
    if (!message) { showError('Please enter a message.'); return; }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const mailto = `mailto:hello@calculateuaegratuity.com?subject=${encodeURIComponent('Contact: ' + (form.elements.namedItem('subject') as HTMLSelectElement).value)}&body=${encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`)}`;
    window.location.href = mailto;

    setTimeout(() => {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send message';
      successEl.textContent = 'Your email client should have opened. If not, email us directly at hello@calculateuaegratuity.com';
      successEl.classList.remove('hidden');
    }, 1500);
  });

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  }
</script>
