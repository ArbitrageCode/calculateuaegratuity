<script>
  import { calculateGratuity } from '../lib/gratuity';

  const form = document.getElementById('gratuity-form') as HTMLFormElement;
  const resultsEl = document.getElementById('results')!;
  const ineligibleEl = document.getElementById('result-ineligible')!;
  const eligibleEl = document.getElementById('result-eligible')!;
  const ineligibleDetail = document.getElementById('ineligible-detail')!;
  const servicePeriodEl = document.getElementById('service-period')!;
  const breakdownBodyEl = document.getElementById('breakdown-body')!;
  const capWarnEl = document.getElementById('cap-warning')!;
  const capWarnTextEl = document.getElementById('cap-warning-text')!;
  const totalAmountEl = document.getElementById('total-amount')!;
  const formErrorEl = document.getElementById('form-error')!;
  const limitedNoteEl = document.getElementById('limited-note')!;

  // Number formatting helpers
  const n2 = (v: number) =>
    new Intl.NumberFormat('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(v);
  const aed = (v: number) => `AED ${n2(v)}`;

  // Toggle limited-contract note based on contract type
  document.querySelectorAll<HTMLInputElement>('input[name="contractType"]').forEach(inp => {
    inp.addEventListener('change', () => {
      limitedNoteEl.classList.toggle('hidden', inp.value !== 'limited');
    });
  });

  form.addEventListener('submit', e => {
    e.preventDefault();
    const fd = new FormData(form);

    const salary = parseFloat(fd.get('monthlySalary') as string);
    const joinStr = fd.get('joinDate') as string;
    const lastStr = fd.get('lastWorkingDate') as string;
    const contractType = fd.get('contractType') as 'limited' | 'unlimited';
    const reason = (fd.get('reason') as 'resignation' | 'termination') ?? 'termination';
    const unpaidDays = Math.max(0, parseInt(fd.get('unpaidLeaveDays') as string || '0', 10) || 0);

    if (!salary || salary <= 0) return showError('Please enter a valid monthly basic salary greater than zero.');
    if (!joinStr) return showError('Please enter your date of joining.');
    if (!lastStr) return showError('Please enter your last working date.');

    const joinDate = new Date(joinStr);
    const lastDate = new Date(lastStr);

    if (isNaN(joinDate.getTime()) || isNaN(lastDate.getTime())) return showError('Please enter valid dates.');
    if (lastDate <= joinDate) return showError('Last working date must be after the date of joining.');

    clearError();

    const result = calculateGratuity({ monthlySalary: salary, joinDate, lastWorkingDate: lastDate, contractType, reason, unpaidLeaveDays: unpaidDays });

    renderResults(result, salary);
  });

  function showError(msg: string) {
    formErrorEl.textContent = msg;
    formErrorEl.classList.remove('hidden');
  }
  function clearError() {
    formErrorEl.textContent = '';
    formErrorEl.classList.add('hidden');
  }

  function tdRow(label: string, formula: string, amount: string, bold = false) {
    const cls = bold ? 'font-semibold text-ink' : 'text-body';
    return `<tr>
      <td class="px-4 py-3 text-sm ${cls}">${label}</td>
      <td class="px-4 py-3 text-[12px] font-mono text-mute hidden sm:table-cell">${formula}</td>
      <td class="px-4 py-3 text-sm text-right font-mono tabular ${bold ? 'font-semibold text-ink' : 'text-body'}">${amount}</td>
    </tr>`;
  }

  function renderResults(r: ReturnType<typeof calculateGratuity>, salary: number) {
    resultsEl.classList.remove('hidden');
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    if (!r.eligible) {
      ineligibleEl.classList.remove('hidden');
      eligibleEl.classList.add('hidden');
      const months = r.serviceMonths.toFixed(1);
      ineligibleDetail.textContent = `Your service period (${r.serviceYearsDisplay}) is less than 12 months.`;
      return;
    }

    ineligibleEl.classList.add('hidden');
    eligibleEl.classList.remove('hidden');

    servicePeriodEl.textContent = r.serviceYearsDisplay;

    // Build table rows
    const rows: string[] = [];

    rows.push(tdRow('Daily wage', `${aed(salary)} ÷ 30`, aed(r.dailyWage)));

    // Tier 1
    const t1Label = r.tier1Months >= 60
      ? `First 5 years × 21 days/year`
      : `${r.serviceYearsDisplay} × 21 days/year`;
    rows.push(tdRow(
      t1Label,
      `${n2(r.tier1Days)} days × ${aed(r.dailyWage)}`,
      aed(r.tier1Amount),
    ));

    // Tier 2 (if any)
    if (r.tier2Months > 0) {
      const t2yrs = parseFloat((r.tier2Months / 12).toFixed(4));
      const t2Label = `${t2yrs} additional year${t2yrs !== 1 ? 's' : ''} × 30 days/year`;
      rows.push(tdRow(
        t2Label,
        `${n2(r.tier2Days)} days × ${aed(r.dailyWage)}`,
        aed(r.tier2Amount),
      ));
    }

    // Subtotal
    rows.push(tdRow('Subtotal', '', aed(r.baseAmount), true));

    // Scaling for unlimited resignation
    if (r.scalingLabel && r.multiplier !== 1) {
      const pct = r.multiplier === 1 / 3 ? '⅓' : '⅔';
      rows.push(tdRow(r.scalingLabel, `× ${pct}`, aed(r.scaledAmount)));
      rows.push(tdRow('After scaling', '', aed(r.scaledAmount), true));
    }

    breakdownBodyEl.innerHTML = rows.join('');

    // Cap warning
    if (r.capApplied) {
      capWarnEl.classList.remove('hidden');
      capWarnTextEl.textContent = `Calculated amount (${aed(r.scaledAmount)}) exceeds the 2-year salary cap. Maximum payable: ${aed(r.capAmount)} (24 months × ${aed(salary)}).`;
    } else {
      capWarnEl.classList.add('hidden');
    }

    totalAmountEl.textContent = aed(r.total);
  }
</script>
