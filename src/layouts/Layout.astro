---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = new URL('/web-app-manifest-512x512.png', Astro.site).href,
  robots = 'index, follow',
} = Astro.props;

// Same labels rendered in this file's own <nav>/<footer> below.
const breadcrumbLabels: Record<string, string> = {
  '/how-it-works': 'How It Works',
  '/faq': 'FAQ',
  '/about': 'About Us',
  '/contact': 'Contact',
  '/privacy-policy': 'Privacy Policy',
  '/terms': 'Terms & Conditions',
};
const normalizedPathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentLabel = breadcrumbLabels[normalizedPathname];

const siteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${Astro.site.href}#organization`,
      name: 'UAE Gratuity Calculator',
      url: Astro.site.href,
      logo: ogImage,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site.href },
        ...(currentLabel
          ? [{ '@type': 'ListItem', position: 2, name: currentLabel, item: canonical }]
          : []),
      ],
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Gratuity" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="UAE Gratuity Calculator" />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
    <script type="application/ld+json" set:html={siteSchema} />

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0J06B23FHK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0J06B23FHK');
    </script>

    <!-- Suppress Google Translate top banner -->
    <style>
      .goog-te-banner-frame, .goog-te-balloon-frame { display: none !important; }
      body { top: 0 !important; }
      .skiptranslate { display: none !important; }
      .goog-te-combo { display: none !important; }
      #goog-gt-tt, .goog-te-balloon-frame { display: none !important; }
      .goog-tooltip, .goog-tooltip:hover { display: none !important; }
    </style>

    <!-- Apply saved theme before paint to prevent flash -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen font-geist antialiased bg-canvas-soft transition-colors duration-200">
    <!-- UAE flag color stripe -->
    <div class="h-1 w-full flex" aria-hidden="true">
      <div class="w-[25%] bg-[#EF3340]"></div>
      <div class="w-[25%] bg-[#009A44]"></div>
      <div class="w-[25%] bg-white dark:bg-[#d0d0d0]"></div>
      <div class="w-[25%] bg-[#1a1a1a]"></div>
    </div>

    <!-- Nav -->
    <header class="nav-glass sticky top-0 z-50 h-16 border-b border-hairline">
      <nav class="max-w-5xl mx-auto px-6 h-full flex items-center justify-between">
        <a href="/" class="flex items-center gap-2" aria-label="UAE Gratuity Calculator home">
          <img src="/favicon-96x96.png" alt="" aria-hidden="true" class="w-6 h-6 rounded-[5px]" />
          <span class="flex flex-col leading-tight">
            <span class="text-sm font-semibold text-ink">UAE Gratuity Calculator</span>
            <span class="text-[10px] text-mute" dir="rtl" lang="ar">حاسبة مكافأة نهاية الخدمة</span>
          </span>
        </a>

        <div class="hidden sm:flex items-center gap-0.5">
          <a href="/#calculator" class="px-3 py-1.5 text-sm text-body hover:text-ink rounded-full hover:bg-canvas-soft transition-colors">Calculator</a>
          <a href="/how-it-works" class="px-3 py-1.5 text-sm text-body hover:text-ink rounded-full hover:bg-canvas-soft transition-colors">How It Works</a>
          <a href="/faq" class="px-3 py-1.5 text-sm text-body hover:text-ink rounded-full hover:bg-canvas-soft transition-colors">FAQ</a>
          <a href="/about" class="px-3 py-1.5 text-sm text-body hover:text-ink rounded-full hover:bg-canvas-soft transition-colors">About</a>
          <a href="/contact" class="px-3 py-1.5 text-sm text-body hover:text-ink rounded-full hover:bg-canvas-soft transition-colors">Contact</a>
          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="ml-1.5 p-1.5 rounded-full text-body hover:text-ink hover:bg-canvas-soft transition-colors"
          >
            <!-- Moon: shown in light mode -->
            <svg id="icon-moon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
            <!-- Sun: shown in dark mode -->
            <svg id="icon-sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </button>
        </div>

        <div class="sm:hidden flex items-center gap-3">
          <a href="/how-it-works" class="text-sm text-body">Guide</a>
          <a href="/faq" class="text-sm text-body">FAQ</a>
          <button
            id="theme-toggle-mobile"
            aria-label="Toggle dark mode"
            class="p-1.5 rounded-full text-body hover:text-ink hover:bg-canvas-soft transition-colors"
          >
            <svg id="icon-moon-m" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
            <svg id="icon-sun-m" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-canvas border-t border-hairline">
      <div class="max-w-5xl mx-auto px-6 py-14">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-10">
          <div class="max-w-xs">
            <p class="text-sm font-semibold text-ink mb-2">UAE Gratuity Calculator</p>
            <p class="text-sm text-mute leading-relaxed">
              Free end-of-service gratuity estimates per UAE Federal Decree-Law
              No.&nbsp;33 of 2021, Article&nbsp;51. Not legal advice.
            </p>
          </div>

          <div class="grid grid-cols-3 gap-x-8 sm:gap-x-12 gap-y-2 text-sm">
            <div>
              <p class="text-[11px] font-mono text-mute uppercase tracking-widest mb-3">Tools</p>
              <ul class="space-y-2">
                <li><a href="/" class="text-body hover:text-ink transition-colors">Calculator</a></li>
                <li><a href="/how-it-works" class="text-body hover:text-ink transition-colors">How It Works</a></li>
                <li><a href="/faq" class="text-body hover:text-ink transition-colors">FAQ</a></li>
              </ul>
            </div>
            <div>
              <p class="text-[11px] font-mono text-mute uppercase tracking-widest mb-3">Company</p>
              <ul class="space-y-2">
                <li><a href="/about" class="text-body hover:text-ink transition-colors">About Us</a></li>
                <li><a href="/contact" class="text-body hover:text-ink transition-colors">Contact</a></li>
              </ul>
            </div>
            <div>
              <p class="text-[11px] font-mono text-mute uppercase tracking-widest mb-3">Legal</p>
              <ul class="space-y-2">
                <li><a href="/privacy-policy" class="text-body hover:text-ink transition-colors">Privacy Policy</a></li>
                <li><a href="/terms" class="text-body hover:text-ink transition-colors">Terms &amp; Conditions</a></li>
                <li><a href="/how-it-works#disclaimer" class="text-body hover:text-ink transition-colors">Disclaimer</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Language selector -->
        <div class="mt-10 pt-6 border-t border-hairline">
          <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-6">
            <span class="text-[11px] font-mono text-mute uppercase tracking-widest shrink-0">Translate page</span>
            <div class="relative">
              <select
                id="lang-select"
                aria-label="Select language"
                class="appearance-none h-8 pl-3 pr-8 bg-canvas-soft border border-hairline rounded-[6px] text-[13px] text-body cursor-pointer hover:border-hairline-strong focus:outline-none focus:border-hairline-strong transition-colors"
              >
                <option value="">English (default)</option>
                <option value="ar">العربية — Arabic</option>
                <option value="hi">हिन्दी — Hindi</option>
                <option value="ur">اردو — Urdu</option>
                <option value="tl">Filipino — Tagalog</option>
                <option value="ml">മലയാളം — Malayalam</option>
                <option value="bn">বাংলা — Bengali</option>
                <option value="ta">தமிழ் — Tamil</option>
                <option value="ne">नेपाली — Nepali</option>
                <option value="pa">ਪੰਜਾਬੀ — Punjabi</option>
                <option value="zh-CN">中文 — Chinese (Simplified)</option>
                <option value="fr">Français — French</option>
                <option value="ru">Русский — Russian</option>
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
            <span class="text-[11px] text-mute">Powered by Google Translate</span>
          </div>
        </div>

        <div class="pt-4 border-t border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <p class="text-[12px] text-mute">
            © {new Date().getFullYear()} UAE Gratuity Calculator. Estimates only. Not legal advice.
          </p>
          <p class="text-[12px] font-mono text-mute">Federal Decree-Law No.&nbsp;33/2021 · Article&nbsp;51</p>
        </div>
      </div>
    </footer>

    <!-- Hidden Google Translate mount point -->
    <div id="google_translate_element" style="display:none" aria-hidden="true"></div>

    <script is:inline>
      // ── Dark mode toggle ────────────────────────────────────────
      function syncThemeIcons() {
        var isDark = document.documentElement.classList.contains('dark');
        var moon  = document.getElementById('icon-moon');
        var sun   = document.getElementById('icon-sun');
        var moonM = document.getElementById('icon-moon-m');
        var sunM  = document.getElementById('icon-sun-m');
        if (moon)  moon.classList.toggle('hidden', isDark);
        if (sun)   sun.classList.toggle('hidden', !isDark);
        if (moonM) moonM.classList.toggle('hidden', isDark);
        if (sunM)  sunM.classList.toggle('hidden', !isDark);
      }

      function toggleTheme() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncThemeIcons();
      }

      document.addEventListener('DOMContentLoaded', function () {
        syncThemeIcons();

        var btn  = document.getElementById('theme-toggle');
        var btnM = document.getElementById('theme-toggle-mobile');
        if (btn)  btn.addEventListener('click', toggleTheme);
        if (btnM) btnM.addEventListener('click', toggleTheme);

        // ── Google Translate ──────────────────────────────────────
        var sel = document.getElementById('lang-select');
        if (!sel) return;

        sel.addEventListener('change', function () {
          var lang = this.value;
          if (!lang) {
            document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
            document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + location.hostname + ';';
            window.location.reload();
            return;
          }
          var attempts = 0;
          var interval = setInterval(function () {
            var combo = document.querySelector('.goog-te-combo');
            if (combo) {
              clearInterval(interval);
              combo.value = lang;
              combo.dispatchEvent(new Event('change'));
            } else if (++attempts > 40) {
              clearInterval(interval);
              document.cookie = 'googtrans=/en/' + lang + '; path=/';
              window.location.reload();
            }
          }, 250);
        });
      });

      // ── Google Translate loader ──────────────────────────────────
      window.googleTranslateElementInit = function () {
        new google.translate.TranslateElement(
          {
            pageLanguage: 'en',
            includedLanguages: 'ar,hi,ur,tl,ml,bn,ta,ne,pa,zh-CN,fr,ru',
            autoDisplay: false,
          },
          'google_translate_element'
        );
      };

      (function () {
        var s = document.createElement('script');
        s.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
        s.async = true;
        document.head.appendChild(s);
      })();
    </script>
  </body>
</html>
